{
  "comments": {
    "blockComment": ["{{--", "--}}"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "<", "close": ">" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] },
    { "open": "{{", "close": "}}" },
    { "open": "{{{", "close": "}}}" },
    { "open": "{!!", "close": "!!}" },
    { "open": "{{--", "close": "--}}" },
    { "open": "<!--", "close": "-->" }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "<", "close": ">" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "`", "close": "`" }
  ],
  "colorizedBracketPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(@(if|unless|isset|empty|auth|guest|can|cannot|component|slot|section|push|prepend|once|foreach|for|while|forelse|switch|production|development|env|markdown|transition|motion|ts|js|raw|verbatim|when|each|lang))\\b",
      "end": "^\\s*(@(endif|endunless|endisset|endempty|endauth|endguest|endcan|endcannot|endcomponent|endslot|endsection|endpush|endprepend|endonce|endforeach|endfor|endwhile|endforelse|endswitch|endproduction|enddevelopment|endenv|endmarkdown|endtransition|endmotion|endts|endjs|endraw|endverbatim|endwhen|endeach|endlang))\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(@(if|unless|isset|empty|auth|guest|can|cannot|component|slot|section|push|prepend|once|foreach|for|while|forelse|switch|production|development|env|markdown|transition|motion|ts|js|raw|verbatim|when|each|lang))\\b|<(?!area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)([a-zA-Z][a-zA-Z0-9]*)\\b[^>]*>(?!.*</\\1>)",
    "decreaseIndentPattern": "^\\s*(@(endif|endunless|endisset|endempty|endauth|endguest|endcan|endcannot|endcomponent|endslot|endsection|endpush|endprepend|endonce|endforeach|endfor|endwhile|endforelse|endswitch|endproduction|enddevelopment|endenv|endmarkdown|endtransition|endmotion|endts|endjs|endraw|endverbatim|endwhen|endeach|endlang|else|elseif|case|default))\\b|^\\s*</"
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
